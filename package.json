{
  "name": "grapestrap",
  "version": "0.1.0-rc.2",
  "description": "Visual Bootstrap 5 editor for Linux. Dreamweaver alternative, MIT, no telemetry.",
  "main": "dist/main/main.js",
  "type": "module",
  "homepage": "https://github.com/juhriah-ops/grapestrap",
  "repository": {
    "type": "git",
    "url": "https://github.com/juhriah-ops/grapestrap"
  },
  "bugs": {
    "url": "https://github.com/juhriah-ops/grapestrap/issues"
  },
  "license": "MIT",
  "author": {
    "name": "GrapeStrap Contributors",
    "email": "juhriah-ops@users.noreply.github.com"
  },
  "scripts": {
    "dev": "vite",
    "start": "electron .",
    "build": "vite build",
    "build:deb": "npm run build && electron-builder --linux deb",
    "build:appimage": "npm run build && electron-builder --linux AppImage",
    "build:rpm": "npm run build && electron-builder --linux rpm",
    "build:tarball": "npm run build && electron-builder --linux tar.gz",
    "build:linux": "npm run build && electron-builder --linux deb rpm AppImage tar.gz",
    "test:e2e": "playwright test",
    "test:unit": "node --test tests/unit/",
    "lint": "eslint src/ plugins/ tests/"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@splidejs/splide": "^4.1.4",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "chokidar": "^3.6.0",
    "electron-log": "^5.1.5",
    "electron-store": "^10.0.0",
    "glightbox": "^3.3.0",
    "golden-layout": "^2.6.0",
    "grapesjs": "^0.21.10",
    "grapesjs-blocks-bootstrap5": "^0.2.31",
    "i18next": "^23.11.5",
    "monaco-editor": "^0.50.0",
    "notyf": "^3.10.0",
    "prettier": "^3.3.2",
    "semver": "^7.6.2",
    "simple-git": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.1",
    "concurrently": "^8.2.2",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.6.0",
    "globals": "^15.15.0",
    "vite": "^5.3.3",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "org.grapestrap.GrapeStrap",
    "productName": "GrapeStrap",
    "copyright": "Copyright © 2026 GrapeStrap Contributors",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "fileAssociations": [
      {
        "ext": "gstrap",
        "name": "GrapeStrap Project",
        "description": "GrapeStrap project",
        "mimeType": "application/x-grapestrap"
      }
    ],
    "linux": {
      "target": [
        "deb",
        "rpm",
        "AppImage",
        "tar.gz"
      ],
      "category": "Development;WebDevelopment",
      "icon": "assets/icons",
      "synopsis": "Dreamweaver-style visual editor for Bootstrap 5",
      "description": "GrapeStrap is a desktop visual editor for building static Bootstrap 5 websites. Class-first styling, Dreamweaver-faithful workflow, plugin-extensible, no telemetry.",
      "desktop": {
        "entry": {
          "Keywords": "html;css;bootstrap;web;editor;dreamweaver;visual;",
          "StartupWMClass": "GrapeStrap"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libsecret-1-0"
      ]
    },
    "appImage": {
      "license": "LICENSE"
    },
    "files": [
      "dist/**/*",
      "plugins/**/*",
      "assets/**/*",
      "starters/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "packaging/desktop/grapestrap-mime.xml",
        "to": "mime/grapestrap-mime.xml"
      }
    ]
  },
  "overrides": {
    "underscore": "^1.13.8"
  }
}
